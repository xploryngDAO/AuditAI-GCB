# AuditAI GCB - ambiente local. Nunca versione segredos.
# O INSTALAR.bat gera este arquivo automaticamente com segredos aleatorios.
NODE_ENV="development"

# Banco de dados local (padrao): sem DATABASE_URL a API usa database_store.json.
# Apenas para recursos relacionais/Estagio 3, defina um Postgres local:
# DATABASE_URL="postgresql://usuario:senha@127.0.0.1:5432/auditai_gcb"

SESSION_SECRET="at-least-32-random-characters-for-development-only"

# Opcional: provisionamento manual de superadministrador (o seed local ja cria).
# SETUP_TOKEN="at-least-32-random-characters-for-initial-provisioning"
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_PASSWORD=""

GEMINI_API_KEY=""

PORT="3000"
APP_URL="http://localhost:3000"
MAX_REQUEST_BODY="25mb"
ALLOW_EPHEMERAL_PERSISTENCE="false"
