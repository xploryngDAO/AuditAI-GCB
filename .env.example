# Nunca versione valores reais. Configure em Vercel > Project Settings.
NODE_ENV="development"

# Postgres (Neon). Em produção a integração da Vercel injeta automaticamente.
DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"

SESSION_SECRET="at-least-32-random-characters-for-development-only"
SETUP_TOKEN="at-least-32-random-characters-for-initial-provisioning"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-16-characters"
GEMINI_API_KEY=""

APP_URL="http://localhost:3000"
MAX_REQUEST_BODY="25mb"
ALLOW_EPHEMERAL_PERSISTENCE="false"

# Estágio 3 (migração híbrida) — banco de staging, NUNCA produção.
# Use um branch Neon dedicado: db:migrate e db:verify rodam contra esta URL.
STAGE3_DATABASE_URL="postgresql://usuario:senha@host/branch_staging?sslmode=require"
